{
  "name": "@tappd/react-native-sdk",
  "version": "1.0.9",
  "description": "Tappd Mobile SDK for React Native (iOS & Android) - Customer Data Platform SDK",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
