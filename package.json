  "license": "MIT",
  "dependencies": {
    "react-native-render-html": "^6.3.4"
  },
  "peerDependencies": {
    "react-native": ">=0.60.0",
    "@react-native-async-storage/async-storage": "^1.19.0",
    "react-native-device-info": ">=10.0.0"
  },
  "devDependencies": {
    "@types/react-native": "^0.72.0",
    "typescript": "^5.0.0"
  }
